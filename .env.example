# Kopieer naar .env.local voor lokaal ontwikkelen. Nooit .env.local committen.
# Browsersleutel voor Maps JavaScript API + Routes API, beperkt op HTTP-referrer.
VITE_GOOGLE_MAPS_KEY=
# Optioneel: eigen Map ID (Google Cloud > Maps Management). Leeg = DEMO_MAP_ID.
VITE_GOOGLE_MAP_ID=
# Optioneel: groepscode-hash, maak met: npm run groepscode -- <code>
VITE_GROEPSCODE_HASH=
